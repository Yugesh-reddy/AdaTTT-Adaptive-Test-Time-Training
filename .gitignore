# Large data & model files
# data/* (not data/) so the frozen evaluation subsets can be un-ignored below —
# git cannot re-include a file whose parent directory is excluded.
data/*
!data/eval_subset_8k.json
!data/gate_train_subset_8k.json
checkpoints/
results/
logs/
figures/

# Binary files
*.pt
*.pth
*.zip
*.tar.gz

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# OS
.DS_Store
