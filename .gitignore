# Large data & model files
# data/* (not data/) so the frozen evaluation subsets can be un-ignored below —
# git cannot re-include a file whose parent directory is excluded.
data/*
!data/eval_subset_8k.json
!data/gate_train_subset_8k.json
checkpoints/
results/*
!results/writeup/
!results/writeup/**
logs/
figures/

# Writeup figures live under results/writeup/figures; `figures/` would
# otherwise ignore that directory even after the results/* exception.
!results/writeup/figures/
!results/writeup/figures/**

# Binary files
*.pt
*.pth
*.zip
*.tar.gz

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# OS
.DS_Store

# Colab orchestrator build outputs (payload tarballs; old in-repo test output)
tools/colab_orchestrator/*.tgz
tools/colab_orchestrator/orchtest/
